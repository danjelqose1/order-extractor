# Copy only to an ignored local env file. Render values belong in its Environment UI.
# Existing application configuration
DB_DIR=data
OPENAI_API_KEY=
FRONTEND_ORIGINS=https://danjelqose1.github.io

# MCP is opt-in. Incomplete configuration fails closed at /mcp.
ORDER_EXTRACTOR_MCP_ENABLED=false
# bearer for private Codex/Inspector; oauth for ChatGPT account linking.
# Modes are exclusive: the shared token is never accepted in oauth mode.
ORDER_EXTRACTOR_MCP_AUTH_MODE=bearer
# Bearer mode only: independently generated 32+ character secret; never put in a URL.
ORDER_EXTRACTOR_MCP_TOKEN=
# OAuth mode: public configuration. Auth0 owns login and token issuance.
# Exact issuer from Auth0 discovery, including its trailing slash.
ORDER_EXTRACTOR_MCP_OAUTH_ISSUER=
ORDER_EXTRACTOR_MCP_RESOURCE_URL=https://order-extractor-kdih.onrender.com/mcp
# Comma-separated Auth0 user_id values. Empty or * denies OAuth access.
ORDER_EXTRACTOR_MCP_ALLOWED_SUBJECTS=
# Copy exact Auth0 Client ID. Comma-separated IDs also permit a separate Inspector client.
# Leave empty only when deliberately permitting other OAuth clients for approved users.
ORDER_EXTRACTOR_MCP_OAUTH_CLIENT_IDS=
ORDER_EXTRACTOR_MCP_READ_ONLY=false
ORDER_EXTRACTOR_MCP_TIMEOUT_SECONDS=30
ORDER_EXTRACTOR_MCP_MAX_LABELS=2000
ORDER_EXTRACTOR_MCP_EXPENSIVE_PER_MINUTE=12
# Set true only after verifying DB_DIR is on durable storage. This is an operator assertion.
ORDER_EXTRACTOR_MCP_DURABLE_STORAGE=false
# Accepted Origin headers, not CORS/preflight configuration. Use Inspector's proxy.
ORDER_EXTRACTOR_MCP_ALLOWED_ORIGINS=
ORDER_EXTRACTOR_NODE_BINARY=node
# Render runtime selector; match the repository .node-version and worker engines.
NODE_VERSION=22
# Match the verified Render runtime and repository .python-version.
PYTHON_VERSION=3.13.4
# Disable loading backend/.env in isolated local runs/tests. Default preserves legacy behavior.
ORDER_EXTRACTOR_LOAD_DOTENV=true
